{
  "name": "cognitivelint_demo",
  "private": true,
  "version": "1.0.0",
  "description": "Demo React app with intentional cognitive UX bugs for CognitiveLint conference talks",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "scan": "cognitivelint scan",
    "scan:json": "cognitivelint scan -f json -o report.json",
    "scan:html": "cognitivelint scan -f html -o report.html"
  },
  "dependencies": {
    "@patternfly/react-core": "^5.4.1",
    "@patternfly/react-icons": "^5.4.1",
    "@patternfly/react-table": "^5.4.1",
    "@tanstack/react-query": "^5.62.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@cognitivelint/cli": "^0.2.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.8.3",
    "vite": "^6.0.3"
  }
}
